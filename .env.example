# YOU IN? · variables de entorno (copia este archivo a .env.local y rellénalo).
# Sin NEXT_PUBLIC_SUPABASE_URL / KEY la app arranca en "modo demo sin servidor":
# solo descubrimiento de eventos, sin cuentas, comunidades ni recompensas.

# Supabase · URL del proyecto y clave publicable (pública, protegida por RLS).
# En local: los valores que imprime `npx supabase start` (API_URL y PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta de servidor. NUNCA en el navegador ni en variables NEXT_PUBLIC_*.
# Solo la usan scripts de mantenimiento (db:refresh-demo) y, en el futuro, los
# webhooks verificados de ticketing.
SUPABASE_SECRET_KEY=

# URL pública de la app (enlaces de confirmación de correo y de referidos).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mapa · proveedor de teselas ráster (plantilla {z}/{x}/{y}) y su atribución.
# Vacío = teselas estándar de OpenStreetMap, aptas solo para desarrollo y poco
# tráfico según su política de uso. En producción usa un proveedor con clave/contrato.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
